<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notification de suivi (autorisation demandée à l'exécution sur Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16+ : afficher le suivi en « Live Update » (puce dans la barre d'état). Permission
         normale (non demandée à l'exécution) ; l'utilisateur peut la désactiver dans les réglages. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Republier la notification d'une session en cours après un redémarrage du téléphone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Import des séances sportives (ex. montre Garmin via Garmin Connect) : lecture seule des
         séances d'exercice dans Health Connect, demandée à l'utilisateur depuis l'écran d'import. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <!-- Aucune permission réseau, stockage, localisation ou service au premier plan. -->

    <application
        android:name=".MonTempsApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MonTemps">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actions (notification, widgets, tuile, alarmes de l'app) : non exporté, atteint
             uniquement par nos PendingIntent explicites. -->
        <receiver
            android:name=".notification.TrackingActionReceiver"
            android:exported="false" />

        <!-- Widgets d'écran d'accueil (mises à jour envoyées par le système). -->
        <receiver
            android:name=".surfaces.TrackingWidgetProvider"
            android:exported="false"
            android:label="@string/widget_tracking_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tracking_info" />
        </receiver>
        <receiver
            android:name=".surfaces.ActivitiesWidgetProvider"
            android:exported="false"
            android:label="@string/widget_activities_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_activities_info" />
        </receiver>

        <!-- Tuile du centre de contrôle : liée uniquement par le système (permission dédiée). -->
        <service
            android:name=".surfaces.TrackingTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_tracking"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Diffusions système protégées : seul Android peut les émettre. -->
        <receiver
            android:name=".notification.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Health Connect : explication de l'autorisation demandée (texte seul). Android 13 et
             moins : action dédiée de Health Connect ; Android 14+ : alias réservé au système
             (permission START_VIEW_PERMISSION_USAGE). -->
        <activity
            android:name=".ui.workouts.HealthPermissionRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".ui.workouts.HealthPermissionRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Montre Garmin : service du SDK Connect IQ auquel l'app Garmin Connect se lie pour
             livrer les messages de la montre. Le SDK vérifie la signature de l'appelant (Garmin)
             avant toute transmission. Désactivé tant que l'utilisateur n'a pas activé la liaison
             (Réglages → Montre Garmin) : sinon, ni Garmin Connect ni aucune autre app ne peut s'y lier. -->
        <service
            android:name="com.garmin.android.connectiq.IQGarminBindingService"
            android:enabled="false"
            tools:ignore="ExportedService"
            tools:replace="android:enabled" />
    </application>
</manifest>
