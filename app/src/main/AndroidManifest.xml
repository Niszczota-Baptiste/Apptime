<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notification de suivi (autorisation demandée à l'exécution sur Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16+ : afficher le suivi en « Live Update » (puce dans la barre d'état). Permission
         normale (non demandée à l'exécution) ; l'utilisateur peut la désactiver dans les réglages. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Republier la notification d'une session en cours après un redémarrage du téléphone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Aucune permission réseau, stockage, localisation ou service au premier plan. -->

    <application
        android:name=".MonTempsApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MonTemps">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actions (notification, widgets, tuile, alarmes de l'app) : non exporté, atteint
             uniquement par nos PendingIntent explicites. -->
        <receiver
            android:name=".notification.TrackingActionReceiver"
            android:exported="false" />

        <!-- Widgets d'écran d'accueil (mises à jour envoyées par le système). -->
        <receiver
            android:name=".surfaces.TrackingWidgetProvider"
            android:exported="false"
            android:label="@string/widget_tracking_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tracking_info" />
        </receiver>
        <receiver
            android:name=".surfaces.ActivitiesWidgetProvider"
            android:exported="false"
            android:label="@string/widget_activities_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_activities_info" />
        </receiver>

        <!-- Tuile du centre de contrôle : liée uniquement par le système (permission dédiée). -->
        <service
            android:name=".surfaces.TrackingTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_tracking"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Diffusions système protégées : seul Android peut les émettre. -->
        <receiver
            android:name=".notification.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
